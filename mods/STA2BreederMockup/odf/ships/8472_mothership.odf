#include "station.odf"

//Race which can build ship & starting race of ship
race = "species8472"

// This ship is built from another ship, not a starbase (used by AIP build lists)
//THIS NEVER SHOULD HAVE BEEN TRUEshipIsBuiltByShips = 1

//Name of Ship class in Ship Display window & in edit mode & tooltip
unitName = "Mother"

//tooltips
tooltip = "8472_MOTHER"
verboseTooltip = "8472_MOTHER_V"

//Can decommission itself anywhere
