; A2FOExtensions DX8 DOT3 pixel shader, derived from armadaNebulaPatch.
; Copyright (c) 2024 dev gao, MIT License
;
; Fleet Operations' stock dot3_directional.nvv vertex shader supplies one UV
; iterator in t0 and the tangent-space light vector encoded in v0. ps.1.4 can
; sample each destination texture stage with that shared t0 coordinate, so no
; replacement vertex shader or extra oT registers are required.
; stage0=diffuse, stage1=native bump/normal, stage2=emissive
; c0=ART_CFG.h A2FO_BUMP_LIGHT_BIAS
; c1=ART_CFG.h A2FO_EMISSIVE_BUMP_MULTIPLIER
; c2=ART_CFG.h A2FO_EMISSIVE_DIFFUSE_RESTORE
ps.1.4

texld r0,t0
texld r1,t0
texld r2,t0

mov r4,r0
dp3_sat r3.rgb,r1_bx2,v0_bx2
add r3.rgb,r3,c0
mul r0.rgb,r0,r3
dp3 r3.rgb,r2,c2
mad r0.rgb,r4,r3,r0
mad_sat r0.rgb,r2,c1,r0
