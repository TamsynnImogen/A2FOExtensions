; A2FOExtensions DX8 DOT3 vertex shader, derived from armadaNebulaPatch.
; Copyright (c) 2024 dev gao, MIT License
;
; v0=position, v2=UV, v3/v4/v5=tangent basis
; c0=1, c1=0.5, c2-c5=clip matrix, c6=light direction
vs.1.1

m4x4 oPos,v0,c2

; Diffuse, native bump, subsystem emissive and specular share material UVs.
mov oT0.xy,v2.xy
mov oT1.xy,v2.xy
mov oT2.xy,v2.xy
mov oT3.xy,v2.xy

; Transform and normalize the light vector into tangent space, then encode it
; from [-1,1] to [0,1] for ps.1.3's DOT3 operation.
dp3 r0.x,v3,c6
dp3 r0.y,v4,c6
dp3 r0.z,v5,c6
dp3 r0.w,r0,r0
rsq r0.w,r0.w
mul r0,r0,r0.w
mad oD0,r0,c1,c1
mov oD0.w,c0.w
